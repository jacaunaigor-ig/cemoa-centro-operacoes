# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env.local e defina os valores correspondentes.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Sessão e operador inicial
CEMOA_SESSION_SECRET=defina-uma-string-longa-e-aleatoria
CEMOA_ADMIN_LOGIN=admin
CEMOA_ADMIN_PASSWORD=defina-uma-senha-forte
CEMOA_ADMIN_NAME=Administrador

# Qualidade do ar (opcional)
PURPLEAIR_API_KEY=sua-chave-purpleair

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=seu-id-de-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-segredo-de-cliente
CEMOA_GOOGLE_EMAILS=
CEMOA_GOOGLE_DOMAIN=
