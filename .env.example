# Copie para `.env.local`. Sem estas chaves o centro segue no modo local (cookie + memória).

# Sessão do operador (obrigatório em produção, mínimo 16 caracteres)
CEMOA_SESSION_SECRET=

# Equipe (logins sugeridos; criar a conta em Equipe)
# karol lenizia luan gustavo adriana thayna igor barroso
# Sem cadastro no quadro → operacional do Centro de Monitoramento

# Primeiro operador do ambiente (opcional; não se apaga pela interface)
CEMOA_ADMIN_LOGIN=igor
CEMOA_ADMIN_PASSWORD=
CEMOA_ADMIN_NAME=Igor

# Supabase — cole a URL e as chaves do projeto. Com isso as classificações
# passam a gravar em alert_overrides / hydro_overrides no Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CEMOA_GOOGLE_EMAILS=
