# Copie para `.env.local`. Sem as chaves do Supabase o centro segue no modo local (cookie + memória).

# Sessão do operador (mínimo 16 caracteres). Em produção, se faltar,
# o cookie é assinado com a SUPABASE_SERVICE_ROLE_KEY.
CEMOA_SESSION_SECRET=

# Equipe (logins sugeridos; criar a conta em Equipe)
# karol lenizia luan gustavo adriana thayna igor barroso
# Sem cadastro no quadro → operacional do Centro de Monitoramento

# Primeiro operador do ambiente (opcional; não se apaga pela interface)
CEMOA_ADMIN_LOGIN=igor
CEMOA_ADMIN_PASSWORD=
CEMOA_ADMIN_NAME=Igor

# Supabase — mesmo projeto associado ao Vercel (xdxmmdwlincochbmwkri).
# Não use nwjirzgygfnkfwlywpdd: esse host não resolve e o login cai em ENOTFOUND.
# A integração Vercel também pode injetar SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://xdxmmdwlincochbmwkri.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CEMOA_GOOGLE_EMAILS=

# PurpleAir (incêndio florestal): chave de leitura em https://develop.purpleair.com/
# Header: X-API-Key / x-api-key
# Mapa: GET /v1/sensors?fields=name,pm2.5_24hour,latitude,longitude&location_type=0
# Um sensor: GET /v1/sensors/{sensor_index}?fields=name,pm2.5_24hour,latitude,longitude
# Campo chave: pm2.5_24hour. Média municipal (não soma). IVE usa essa média de 24 h.
PURPLEAIR_API_KEY=

