# Copie para `.env.local`. Sem admin de ambiente, o primeiro acesso cria a conta local.

# Sessão do operador (obrigatório em produção no Vercel, mínimo 16 caracteres)
CEMOA_SESSION_SECRET=

# Primeiro operador do ambiente (recomendado no Vercel; não se apaga pela interface)
CEMOA_ADMIN_LOGIN=igor
CEMOA_ADMIN_PASSWORD=
CEMOA_ADMIN_NAME=Igor

# Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CEMOA_GOOGLE_EMAILS=
